{
  "name": "omo-coworkers",
  "version": "8.0.1",
  "type": "module",
  "description": "OpenChamber capability panel with focused coworker role settings, explicit project-content adoption, and native skills and plugin contributions.",
  "license": "MIT",
  "keywords": [
    "opencode",
    "oh-my-opencode-slim",
    "agents",
    "subagents",
    "openchamber",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LittleKey/omo-coworkers.git"
  },
  "homepage": "https://github.com/LittleKey/omo-coworkers#readme",
  "bugs": "https://github.com/LittleKey/omo-coworkers/issues",
  "files": [
    "openchamber",
    "skills",
    "plugins",
    "README.md",
    "INSTALL.md",
    "SOURCES.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs plugins/claude-advisor/guard.test.mjs"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": { "openchamber": ">=2.8.0" },
    "contributes": {
      "panel": { "id": "omo-coworkers", "name": "OMO Coworkers", "icon": "ri-team-line", "entry": "openchamber/panel/index.html", "mobile": true },
      "service": { "entry": "openchamber/service/main.mjs", "runtime": "host", "provides": ["opencode"] },
      "skills": "skills",
      "opencodePlugin": "openchamber/plugin"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
