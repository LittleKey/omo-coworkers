{
  "name": "omo-coworkers",
  "version": "4.0.0",
  "type": "module",
  "description": "OpenChamber extension with coworker skills and an operator-opt-in Claude dispatch guard; role configuration is managed separately.",
  "license": "MIT",
  "keywords": [
    "opencode",
    "oh-my-opencode-slim",
    "agents",
    "subagents",
    "openchamber",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LittleKey/omo-coworkers.git"
  },
  "homepage": "https://github.com/LittleKey/omo-coworkers#readme",
  "bugs": "https://github.com/LittleKey/omo-coworkers/issues",
  "bin": {
    "supervisor-memory": "./bin/supervisor-memory.mjs"
  },
  "files": [
    "bin",
    "openchamber",
    "skills",
    "plugins",
    "README.md",
    "INSTALL.md",
    "SOURCES.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs plugins/claude-advisor/guard.test.mjs"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": { "openchamber": ">=2.7.2" },
    "contributes": {
      "panel": { "id": "omo-coworkers", "name": "OMO Coworkers", "icon": "ri-team-line" },
      "skills": "skills",
      "opencodePlugin": "openchamber/plugin"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
